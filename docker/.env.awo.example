# Run `node scripts/awo-docker.mjs setup` to generate docker/.env.awo.
# Do not copy this template directly: both signing secrets must be generated.
# Keep the generated file private and back it up with the Docker data volume.
# Existing secrets must stay unchanged across restarts and upgrades.
BETTER_AUTH_SECRET=__GENERATED_SESSION_SECRET__
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=__GENERATED_TOOL_SECRET__

PAPERCLIP_PORT=3100
# The launcher derives http://localhost:<PAPERCLIP_PORT> when this is blank.
PAPERCLIP_PUBLIC_URL=
PAPERCLIP_ALLOWED_HOSTNAMES=

# Optional. Prefer connecting your account in Apps → Connections after sign-in.
# Supplying a key does not create agents or start any agent tasks.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
